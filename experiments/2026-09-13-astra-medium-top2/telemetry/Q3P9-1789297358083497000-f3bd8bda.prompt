\begin{tabular}{lccc}
\toprule
\textbf{Metric} & \textbf{Within-board std} & \textbf{Between-board std} & \textbf{Ratio} \\
\midrule
Both Finished & 0.180 & 0.407 & 2.3$\times$ \\
Normalized Joint Reward & 0.094 & 0.209 & 2.2$\times$ \\
