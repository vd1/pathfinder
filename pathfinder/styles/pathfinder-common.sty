% pathfinder-common: what the three Pathfinder documents share. Not loaded directly;
% pathfinder-note, pathfinder-readable and pathfinder-paper load it and set the colour and kind.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pathfinder-common}[2026/09/13 shared preamble for Pathfinder documents]
\RequirePackage[a4paper,margin=24mm,headheight=14pt,headsep=8mm]{geometry}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{fancyhdr}
\RequirePackage{url}
\RequirePackage[hidelinks]{hyperref}
\urlstyle{same}
\emergencystretch=2em
\setlength{\parskip}{3pt}
% identity of the document: kind is set by the loading package, pair by the author
\newcommand{\pathfinder@kind}{Pathfinder}
\newcommand{\pathfinder@pair}{}
\newcommand{\pathfinderpair}[1]{\renewcommand{\pathfinder@pair}{#1}}
% the two papers, printed under the title with links to their arXiv abstracts, and a status line;
% the pipeline writes them to pathfinder-meta.tex beside the document, read at the end of this file
\newcommand{\pathfinder@papers}{}
\newcommand{\pathfinderpapers}[4]{\renewcommand{\pathfinder@papers}{%
  \noindent{\small\textbf{Q}\quad\href{https://arxiv.org/abs/#1}{#2}\quad{\color{pathfinder@ink}\sffamily\scriptsize arXiv:#1}\par}%
  \noindent{\small\textbf{P}\quad\href{https://arxiv.org/abs/#3}{#4}\quad{\color{pathfinder@ink}\sffamily\scriptsize arXiv:#3}\par}}}
\newcommand{\pathfinder@status}{}
\newcommand{\pathfinderstatus}[1]{\renewcommand{\pathfinder@status}{#1}}
\definecolor{pathfinder@ink}{HTML}{555555}
% running header: a thin rule in the document's colour, the kind on the left, the pair on the right
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{{\color{pathfinder@ink}\hrule width\headwidth height\headrulewidth}}
\fancyhead[L]{\color{pathfinder@ink}\sffamily\scriptsize\MakeUppercase{\pathfinder@kind}}
\fancyhead[R]{\color{pathfinder@ink}\sffamily\scriptsize\pathfinder@pair\ifx\@date\@empty\else\quad\textperiodcentered\quad\@date\fi}
\fancyfoot[C]{\sffamily\scriptsize\thepage}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\sffamily\scriptsize\thepage}\renewcommand{\headrulewidth}{0pt}}
% title block: kind above the title, no author line unless given
\renewcommand{\maketitle}{%
  \begingroup
  \thispagestyle{plain}
  \noindent{\color{pathfinder@ink}\sffamily\scriptsize\MakeUppercase{\pathfinder@kind}%
    \ifx\pathfinder@pair\@empty\else\quad\textperiodcentered\quad\pathfinder@pair\fi%
    \ifx\@date\@empty\else\quad\textperiodcentered\quad\@date\fi}\par
  \vspace{2pt}{\color{pathfinder@ink}\hrule height 0.6pt}\vspace{10pt}
  {\raggedright\LARGE\bfseries\@title\par}
  \ifx\@author\@empty\else\vspace{6pt}{\large\@author\par}\fi
  \ifx\pathfinder@papers\@empty\else\vspace{8pt}\pathfinder@papers\fi
  \ifx\pathfinder@status\@empty\else\vspace{4pt}\noindent{\color{pathfinder@ink}\sffamily\scriptsize\pathfinder@status\par}\fi
  \vspace{14pt}
  \endgroup}
% the date of production; the prompts pass it explicitly, \today is the fallback at build time
\date{\today}
\author{}
% the pipeline's metadata for this document: pair, papers, date, status
\InputIfFileExists{pathfinder-meta}{}{}
